{
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*.@(html|css|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
