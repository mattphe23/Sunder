<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sunder privacy manifest (app target).

  Capacitor ships its own manifest for its framework and it declares nothing —
  no required-reason APIs, no collected data. That is correct for the framework
  and wrong for the app: everything Sunder collects, it collects through its own
  server, so the declaration has to live here.

  NSPrivacyAccessedAPITypes is deliberately EMPTY. Required-reason APIs are
  Swift/ObjC calls, and the only native code in this app is Capacitor's own
  template. Browser localStorage inside WKWebView is WebKit storage, not
  UserDefaults, so it does not trigger the UserDefaults category (CA92.1) — a
  distinction worth keeping in mind, because adding @capacitor/preferences later
  WOULD, and would need that category added here.

  If Apple ever emails an ITMS-91053 "missing API declaration" notice, it names
  the exact category; add that one rather than guessing a set up front, since an
  over-broad declaration earns ITMS-91055 instead.

  Everything below is "linked to the user" and "not used for tracking": there is
  no ad network, no analytics SDK, no third-party identifier in this app, and no
  data leaves the game except to its own API and to Stripe at checkout.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- from OAuth sign-in: identifies the account that owns a save, a
		     leaderboard score and any purchases -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- the account id, and the commander name shown on the leaderboard -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- which SKUs an account owns, so unlocks follow the player across
		     devices; card details and receipts never reach this app -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- match results, lifetime stats and challenge scores — the
		     Commander's Record and the global leaderboard -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUsageData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
